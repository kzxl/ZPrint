<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZPrint.Core</AssemblyName>
    <RootNamespace>ZPrint.Core</RootNamespace>
    <PackageId>ZPrint.Core</PackageId>
    <Version>1.0.0</Version>
    <Description>High-performance, zero-dependency network printer sharing engine, IPP RFC 8011 server, Win32 direct spooler, and ZeroLz4 wire protocol for ZeroUniverse.</Description>
    <PackageTags>printer;print-server;canon2900;spooler;ipp;airprint;network-printer;zeroapps</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net462'">
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\ZeroPlatform\ZeroNetwork\src\ZeroNetwork.Core\ZeroNetwork.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZPrint.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ZPrint.Tool</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
